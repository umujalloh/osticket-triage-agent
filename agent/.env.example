# Copy to agent/.env and fill in real values. Never commit the result.
# Setup steps for each value are in the README, Sections 2 through 4.

# Required. Asserted at import time, so a missing one refuses to boot rather
# than starting in a degraded state.
ANTHROPIC_API_KEY=
TRIAGE_HMAC_SECRET=
SPLUNK_HEC_URL=https://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=

# Required, and must be exactly true or false. The kill switch for every
# effectful write: internal notes, priority changes, Slack posts, PagerDuty
# pages. Audit logging to Splunk ignores it and always runs. There is no
# default because both would be wrong, one writes to real tickets by accident
# and the other silently does nothing.
ENABLE_WRITES=false

# Required for write-back. osTicket's own API creates tickets and runs cron,
# neither of which touches an existing ticket, so notes and priority go through
# endpoints the triage plugin registers. The URL is the base those hang off.
# The secret is separate from TRIAGE_HMAC_SECRET above, so a leak of the inbound
# secret does not also grant writing into tickets. Set the same value in the
# plugin's settings in the osTicket admin panel.
OSTICKET_WRITE_URL=http://localhost:8080/api/triage
TRIAGE_WRITE_SECRET=

# Required only when ENABLE_WRITES is true, so a lab with no Slack workspace
# still boots with writes off. All three are required together: a deployment
# missing one would believe it is alerting on the tickets that channel carries.
#
# One webhook per channel, because a webhook is bound to its channel, so a
# leaked one posts there and nowhere else. Each URL is a bearer credential.
# Reasoning in architecture.md, Section 7.
SLACK_WEBHOOK_URGENT=
SLACK_WEBHOOK_INCIDENTS=
SLACK_WEBHOOK_REVIEW=

# Where alert and page links point, so it has to be an address the people
# reading them can actually reach. Always required, unlike the webhooks above,
# because a message is built before the kill switch decides whether to send it.
OSTICKET_BASE_URL=http://localhost:8080

# Required when writes are on, same exception as the webhooks. PagerDuty's UI
# calls these Integration Keys. The API field is routing_key, which is the name
# used here. Each is a bearer credential scoped to one service, so a leaked key
# can trigger incidents there and nowhere else.
#
# Two services, because urgency is a property of a PagerDuty service and not
# something an event can ask for. WAKE must be set to high urgency and NOTIFY to
# low urgency, and neither is visible to the agent, so both are deployment
# preconditions. Reasoning in architecture.md, Section 7.
PAGERDUTY_ROUTING_KEY_WAKE=
PAGERDUTY_ROUTING_KEY_NOTIFY=

# Optional. Only set this for an account in PagerDuty's EU service region.
# PAGERDUTY_EVENTS_URL=https://events.eu.pagerduty.com/v2/enqueue

# Optional. A fourth channel used only by verify_slack.py, so the three real
# channels carry nothing but real alerts.
SLACK_WEBHOOK_TEST=

# Optional. A third PagerDuty service used only by the verifiers, so the two
# real ones hold nothing but real pages. Both destinations are pointed at it
# during a run, which proves delivery but says nothing about urgency, since
# urgency belongs to the service.
PAGERDUTY_ROUTING_KEY_TEST=

# Optional. Where verify_webhook.py sends its requests, defaulting to
# 127.0.0.1:8000. This is the address the agent bound to, which is not the one
# osTicket uses when it runs in a container and reaches the host by another
# route.
TRIAGE_WEBHOOK_URL=http://127.0.0.1:8000/webhook/ticket

# Required for enrichment. The password is the same value set as
# SPLUNK_AGENT_PASSWORD in docker/.env before running provision-splunk-user.sh.
SPLUNK_SEARCH_URL=https://localhost:8089
SPLUNK_AGENT_PASSWORD=

# Optional, shown with their defaults.

# Splunk account used for enrichment searches. Read-only, scoped to one index.
SPLUNK_AGENT_USER=triage_agent

# Earliest time for enrichment searches. -7d is the sensible window against live
# telemetry. BOTSv3 is frozen in 2018 and 2019, so a relative window can never
# reach it. Set to 0 to search all time against the demo dataset.
SPLUNK_ENRICHMENT_EARLIEST=-7d

# Classification model. Models outside the Claude 5 series are sent
# temperature=0. Claude 5 models reject sampling parameters, so they are sent
# with thinking disabled instead.
TRIAGE_MODEL=claude-haiku-4-5
